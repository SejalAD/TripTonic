<% layout("/layouts//boilerplate") %>

<div class="row mt-3">

    <div class="col-8 offset-2">
        <h3>Create a new listing</h3>
        <form action="/listings" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
            <!-- create key value pair on name field will make it easier to access them and store them into db-->
            

            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" name="listing[title]" id=""minlength =3 placeholder="Add title" class="form-control" required>
                <div class="invalid-feedback">Please enter valid title</div>
            </div>
            

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea type="text" name="listing[description]" id="" placeholder="enter description" class="form-control" required></textarea>
                <div class="invalid-feedback">Please enter a short description</div>
            </div>
            
            
            <!-- <div class="mb-3">
                <label for="image" class="form-label">Image Link</label>
                <input type="text" name="listing[image][url]" id="" placeholder="enter image URL/Link" class="form-control" >

            </div> -->

            <div class="mb-3">
                <label for="image" class="form-label">Upload Listing Image</label>
                <input type="file" name="listing[image]" id="" class="form-control" >

            </div>
        

            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price</label>
                    <input type="number" name="listing[price]" id="" placeholder="1200" class="form-control" required>
                    <div class="invalid-feedback">Please enter valid price</div>
                </div>

                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="listing[country]" id="" placeholder="enter country"class="form-control" required>
                    <div class="invalid-feedback">Please enter the country name</div>
                </div>

            </div>   

            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input type="text" name="listing[location]" id="" placeholder="enter location" class="form-control" required>
                <div class="invalid-feedback">Please enter the location</div>
            </div>
        
            <button class="btn btn-dark add-btn mt-3 mb-3">Add</button>

            
        </form>
    </div>

</div>