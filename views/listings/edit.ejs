<% layout("/layouts//boilerplate") %>

<div class="row mt-3">
    <div class="col-8 offset-2">

        <h3>Edit your listing</h3>
        <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
            <!-- create key value pair on name field will make it easier to access them and store them into db-->

            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" name="listing[title]" id=""class="form-control" value="<%=listing.title%>" required>
            </div>
            
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea type="text" name="listing[description]" id="" class="form-control" required ><%= listing.description %></textarea>
            </div>

            <div class="mb-3">
                Original Image<br>
                
                <img src="<%= originalImageUrl %>">

            </div>
            
            <div class="mb-3">
                <label for="image" class="form-label">Upload New Image</label>
                <input type="file" name="listing[image]" id="" class="form-control" value="<%=listing.image.url%>" required>
            </div>
            

            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price</label>
                    <input type="number" name="listing[price]" class="form-control" id="" value="<%=listing.price %>" required>
                </div>

                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="listing[country]" id=""class="form-control"  value="<%=listing.country %>" required>
                </div>
            </div>
            
            

            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input type="text" name="listing[location]" id="" class="form-control"  value="<%=listing.location %>" required>
            </div>
            
            
            <button class="btn btn-dark edit-btn mb-3 mt-3">Edit</button>
        </form>
    
    </div>
</div>
